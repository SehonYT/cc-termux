function decode(s) {
  return s.replace(/<[^>]+>/g, " ").replace(/&amp;/g, "&").replace(/&nbsp;/g, " ").replace(/&#x27;/g, "'").replace(/\s+/g, " ").trim();
}
function ctxTokens(s) {
  const m = String(s || "").match(/^([\d.]+)\s*([KMG])$/i);
  if (!m) return null;
  const mult = { K: 1e3, M: 1e6, G: 1e9 }[m[2].toUpperCase()];
  return Math.round(parseFloat(m[1]) * mult);
}

async function fetchCatalog() {
  const r = await fetch("https://tokens.bd/models");
  const html = await r.text();
  const rows = html.split("<tr").slice(1);
  const models = [];
  for (const row of rows) {
    const cells = [...row.matchAll(/<td[^>]*>([\s\S]*?)<\/td>/g)].map(m => decode(m[1]));
    if (cells.length < 6) continue;
    const idm = cells[1].match(/([A-Za-z0-9][A-Za-z0-9._-]*\/[A-Za-z0-9._-]+|[a-z0-9][a-z0-9._-]{4,})$/);
    if (!idm) continue;
    const id = idm[1];
    const name = cells[1].slice(0, cells[1].length - id.length).trim();
    const ctx = cells[3];
    const inUsd = parseFloat((cells[4] || "").replace(/[^0-9.]/g, ""));
    const outUsd = parseFloat((cells[5] || "").replace(/[^0-9.]/g, ""));
    models.push({ id, name, provider: cells[2], context: ctx, contextTokens: ctxTokens(ctx), inUsd, outUsd, plans: cells[6] });
  }
  const r2 = await fetch("https://tokens.bd/v1/models", { headers: { authorization: "Bearer " + keyFor() } }).catch(() => null);
  let usable = null;
  if (r2 && r2.ok) { try { const j = await r2.json(); usable = new Set((j.data || j || []).map(m => m.id)); } catch {} }
  for (const m of models) m.usable = usable ? usable.has(m.id) : null;
  const out = { fetchedAt: new Date().toISOString(), models };
  fs.mkdirSync(path.dirname(CATALOG), { recursive: true });
  fs.writeFileSync(CATALOG, JSON.stringify(out, null, 1));
  return out;
}

function keyFor() {
  const c = load();
  const p = c.providers[c.active] || {};
  if (p.apiKey) return p.apiKey.startsWith("env:") ? (process.env[p.apiKey.slice(4)] || "") : p.apiKey;
  return p.apiKeyEnv ? (process.env[p.apiKeyEnv] || "") : "";
}

async function catalog(force) {
  if (!force && fs.existsSync(CATALOG)) {
    const c = JSON.parse(fs.readFileSync(CATALOG, "utf8"));
    if (Date.now() - new Date(c.fetchedAt).getTime() < 6 * 3600 * 1000) return c;
  }
  return await fetchCatalog();
}

async function health() {
  try {
    const c = load();
    const r = await fetch("http://127.0.0.1:" + port(c) + "/health");
    return await r.json();
  } catch { return null; }
}

switch (cmd) {
  case "status": {
    const c = load();
    const h = await health();
    const color = (code, s) => process.stdout.isTTY ? "\x1b[" + code + "m" + s + "\x1b[0m" : s;
    const dim = (s) => color("2", s);
    const bold = (s) => color("1", s);
    const strip = (s) => String(s).replace(/\x1b\[[0-9;]*m/g, "");
    const pad = (s, n) => strip(s).padEnd(n);
    let stamp = {};
    try { stamp = JSON.parse(fs.readFileSync(path.join(ROOT, "cc-termux.json"), "utf8")); } catch (e) { }
    let activeName = c.active;
    let active = c.providers && c.providers[activeName];
    let activeId = active && active.model;
    try {
      const st = JSON.parse(fs.readFileSync(SETTINGS_PATH, "utf8"));
      const m = /^prov\/([^/]+)\/(.+)$/.exec(String(st.model || ""));
      if (m && c.providers && c.providers[m[1]]) { activeName = m[1]; active = c.providers[activeName]; activeId = m[2]; }
    } catch (e) { }
    const activeModel = active && (active.modelsById && active.modelsById[activeId] ? active.modelsById[activeId].name : activeId || active.model || active.defaultModel || "-");
    const keyState = active ? (active.type === "antigravity" ? "OAuth" : active.noKey ? "no key" : ((loadKeys()[activeName] || active.apiKeyEnv) ? "key set" : "no key")) : "";
    console.log();
    console.log(bold("  cc-termux") + dim("  " + (stamp.version || "dev") + "  " + process.platform + " " + process.arch));
    console.log();
    console.log("  gateway   " + (h ? color("32", "● UP") + dim("  http://127.0.0.1:" + port(c)) : color("33", "○ DOWN") + dim("  starts automatically with claude")));
    console.log("  active    " + (activeName ? bold(activeName) + (active && active.type !== activeName ? dim("  " + active.type) : "") : dim("none")));
    const activeCtx = active && (active.modelsById && active.modelsById[activeId] && active.modelsById[activeId].contextTokens) || (active && active.contextWindow);
    console.log("  model     " + (activeModel || "-") + (activeCtx ? dim("  " + Math.round(activeCtx / 1000) + "K ctx") : "") + dim(keyState ? "  " + keyState : ""));
    try {
      const sf = path.join(CACHE, "antigravity-status.txt");
      if (active && active.type === "antigravity") {
        const line = fs.readFileSync(sf, "utf8").trim();
        if (/^antigravity · /.test(line)) console.log("  quota     " + line.replace(/^antigravity · [^·]+ · /, ""));
      }
    } catch (e) { }
    console.log();
    console.log(dim("  providers"));
    for (const [name, p] of Object.entries(c.providers || {})) {
      if (p.hidden) continue;
      const model = (name === activeName && activeId) ? activeId : (p.model || p.defaultModel || "-");
      const isActive = name === activeName;
      const marker = isActive ? color("32", "●") : dim("○");
      const key = p.type === "antigravity" ? "OAuth" : p.noKey ? "no key" : ((loadKeys()[name] || p.apiKeyEnv) ? "key set" : "no key");
      console.log("   " + marker + " " + pad(name, 15) + dim(pad(p.type, 12)) + pad(model, 32) + dim(key));
    }
    if (!Object.keys(c.providers || {}).filter((n) => !c.providers[n].hidden).length) {
      console.log(dim("   no providers yet - run: cc-termux setup"));
    }
    console.log();
    if (Object.keys(c.providers || {}).filter((n) => !c.providers[n].hidden).length) {
      console.log(dim("  next: ") + "claude" + dim("   |   /model to switch   |   /provider to switch provider   |   cc-termux doctor"));
    } else {
      console.log(dim("  next: ") + "cc-termux setup" + dim("   adds a provider (OpenRouter, Gemini, Antigravity, local...) "));
    }
    console.log();
    break;
  }
  case "provider": {
    const c = load();
    const settingsPath = path.join(claudeDir(), "settings.json");
    const setDefaultModel = (composite) => {
      try {
        const s = fs.existsSync(settingsPath) ? JSON.parse(fs.readFileSync(settingsPath, "utf8")) : {};
        s.model = composite;
        fs.mkdirSync(path.dirname(settingsPath), { recursive: true });
        fs.writeFileSync(settingsPath, JSON.stringify(s, null, 2) + "\n");
      } catch (e) { console.error("could not update settings.json:", e.message); }
    };
    const composite = (name, model) => model ? "prov/" + name + "/" + model : model;
    if (args[0] === "--json") {
      const ks = loadKeys();
      const rows = Object.entries(c.providers || {}).filter(([, p]) => !p.hidden).map(([name, p]) => ({
        name, active: name === c.active, model: p.model || p.defaultModel || null, type: p.type, key: mask(ks[name] || ""),
      }));
      console.log(JSON.stringify(rows, null, 1));
      break;
    }
    if (!args[0] || args[0] === "list") {
      let shown = 0;
      for (const [name, p] of Object.entries(c.providers || {})) {
        if (p.hidden) continue;
        const model = (name === c.active && c.override && c.override.model) ? c.override.model : (p.model || p.defaultModel || "-");
        const keyLabel = p.type === "antigravity" ? "OAuth" : p.noKey ? "no key" : mask(loadKeys()[name] || (p.apiKeyEnv ? "env:" + p.apiKeyEnv : ""));
        console.log((name === c.active ? " \u2714 " : "   ") + name.padEnd(14) + String(p.type).padEnd(12) + " " + model + "  key=" + keyLabel);
        shown++;
      }
      if (!shown) console.log("no providers configured - run: cc-termux setup");
      if (c.override) console.log("override: " + c.override.provider + " -> " + (c.override.model || "default"));
      break;
    }
    if (args[0] === "off") { delete c.override; save(c); refreshStatusLineFile(); console.log("override cleared; active provider: " + c.active); break; }
    const name = args[0];
    if (!c.providers[name]) { console.error("unknown provider:", name); console.error("known: " + Object.keys(c.providers || {}).join(", ")); process.exit(1); }
    const p = c.providers[name];
    c.active = name;
    c.override = { provider: name, model: p.model || p.defaultModel || null };
    save(c);
    if (p.model) setDefaultModel(composite(name, p.model));
    refreshStatusLineFile();
    console.log("active provider -> " + name + " (" + (p.model || p.defaultModel) + ")");
    console.log("the running Claude Code session switches on its next request");
    break;
  }
  case "key": {
    const c = load();
    const [name, key] = args;
    if (!name || !key) { console.error("usage: cc-termux key <provider> <key>"); process.exit(1); }
    if (!c.providers[name]) { console.error("unknown provider:", name); process.exit(1); }
    const ks = loadKeys(); ks[name] = key; saveKeys(ks);
    console.log("stored key for " + name + " in keys.json");
    break;
  }
  case "model":
  case "use": {
    const c = load();
    let id = args[0];
    if (!id) { console.error("usage: cc-termux use <model-id>   (see: cc-termux models)"); process.exit(1); }
    const cat = await catalog(false);
    const entry = cat.models.find(m => m.id === id);
    if (!entry) { console.error("model not found in catalog: " + id); process.exit(1); }
    const p = c.providers[c.active];
    p.model = entry.id;
    p.defaultModel = entry.id;
    p.contextWindow = entry.contextTokens || p.contextWindow || 128000;
    p.aliases = { opus: entry.id, sonnet: entry.id, haiku: entry.id, subagent: entry.id };
    save(c);
    try {
      const st = JSON.parse(fs.readFileSync(SETTINGS_PATH, "utf8"));
      st.model = "prov/" + c.active + "/" + entry.id;
      fs.writeFileSync(SETTINGS_PATH, JSON.stringify(st, null, 2) + "\n");
    } catch (e) { }
    refreshStatusLineFile();
    console.log("active model -> " + entry.id + "  (" + entry.name + ", ctx " + entry.context + " = " + p.contextWindow + " tokens, $" + entry.inUsd + "/$" + entry.outUsd + " per 1M)");
    console.log("aliases opus/sonnet/haiku/subagent -> " + entry.id);
    console.log("restart Claude Code to apply.");
    break;
  }
  case "sync": {
    const cat = await catalog(true);
    console.log("catalog refreshed: " + cat.models.length + " models at " + cat.fetchedAt);
    break;
  }
  case "models": {
    const cat = await catalog(false);
    const list = cat.models.filter(m => args.includes("--all") || m.usable !== false);
    list.sort((a, b) => a.inUsd - b.inUsd || a.outUsd - b.outUsd);
    console.log("catalog " + cat.fetchedAt + "  (" + list.length + " models; usable by this key unless marked *)");
    console.log("id".padEnd(44) + "ctx".padEnd(8) + "in/1M".padEnd(9) + "out/1M".padEnd(9) + "availability");
    for (const m of list) {
      const mark = m.usable === false ? "*" : " ";
      console.log(mark + m.id.padEnd(43) + String(m.context).padEnd(8) + ("$" + m.inUsd).padEnd(9) + ("$" + m.outUsd).padEnd(9) + String(m.plans || ""));
    }
    break;
  }
  case "map": {
    const c = load();
    const [name, from, to] = args;
    if (!name || !from || !to) { console.error("usage: cc-termux map <provider> <claude-model> <upstream-model>"); process.exit(1); }
    if (!c.providers[name]) { console.error("unknown provider:", name); process.exit(1); }
    c.providers[name].models = c.providers[name].models || {};
    c.providers[name].models[from] = to; save(c);
    console.log(name + ": " + from + " -> " + to);
    break;
  }
  case "test": {
    const prompt = args.join(" ") || "Reply with exactly: GATEWAY OK";
    const out = execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-launcher.mjs"), "-p", "--output-format", "json", prompt], { encoding: "utf8", timeout: 180000 });
    try { const j = JSON.parse(out); console.log(j.result || JSON.stringify(j)); } catch { console.log(out); }
    break;
  }
  case "logs": {
    const f = path.join(CACHE, "gateway.log");
    if (!fs.existsSync(f)) { console.log("no gateway log yet - run claude to start the gateway"); break; }
    console.log(fs.readFileSync(f, "utf8").split("\n").slice(-60).join("\n"));
    break;
  }
  case "restart": {
    const pids = await gatewayPids();
    for (const pid of pids) {
      // Default signal only: on Windows SIGTERM is not a real signal (Node emulates it as an
      // unconditional kill), so passing it explicitly buys nothing; on POSIX the default is
      // SIGTERM, which is what we want.
      try { process.kill(pid); } catch (e) { }
    }
    if (pids.length) {
      forgetPidFile();
      console.log("gateway stopped; restarts on the next claude run");
    } else {
      console.log("no verified gateway process found; it will start on the next claude run");
    }
    break;
  }
  case "patch": {
    const sub = args[0] === "revert" ? "--revert" : args[0] === "status" ? "--status" : "--apply";
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-patch.mjs"), sub], { stdio: "inherit" });
    break;
  }
  case "setup": {
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-setup.mjs"), ...args], { stdio: "inherit" });
    break;
  }
  case "update": {
    const sub = args[0] === "--check" ? "--check" : "--self-update";
    const extra = sub === "--self-update" && args.includes("--redownload") ? ["--redownload"] : [];
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-update.mjs"), sub, ...extra], { stdio: "inherit" });
    break;
  }
  case "path": {
    console.log("root   : " + ROOT);
    console.log("config : " + CFG);
    break;
  }
  case "doctor": {
    await doctor(args.includes("--fix"));
    break;
  }
  case "sync-picker": {
    const c = load();
    const r = writePicker(c);
    console.log("picker rebuilt: " + r.switchRows.length + " switch rows + " + r.options.length + " models");
    break;
  }
  case "usage": {
    const c = load();
    const name = args[0] || c.active;
    const p = c.providers[name];
    if (!p) { console.error("unknown provider:", name); process.exit(1); }
    const key = loadKeys()[name];
    if (!key) { console.error("no key stored for " + name); process.exit(1); }
    if (/tokens\.bd/.test(p.baseUrl || "")) {
      const r = await fetch("https://tokens.bd/v1/tokens/usage", { headers: { authorization: "Bearer " + key } });
      const j = await r.json();
      console.log("provider: " + name + "  plan: " + (j.plan && j.plan.name));
      for (const w of j.windows || []) console.log("  " + w.label + ": $" + Number(w.used).toFixed(4) + " / $" + w.limit + "  (" + w.percentUsed + "%)");
      if (j.key) console.log("  key: monthly cap $" + j.key.monthlySpendCapUsd);
      break;
    }
    if (/router\.bynara\.id/.test(p.baseUrl || "")) {
      const cache = readNaraCache() || {};
      const plans = cache.plans || await naraFetchPlans();
      writeNaraCache({ ...cache, plans, plansAt: new Date().toISOString() });
      console.log("provider: " + name + "  (" + p.baseUrl + ")");
      console.log(naraFormatUsage(plans, { active: p.plan || process.env.NARA_PLAN || "free", observed: cache.observed || null }));
      break;
    }
    console.log("provider: " + name + "  (" + p.baseUrl + ")");
    console.log("  no usage endpoint known for this provider");
    try {
      const q = JSON.parse(fs.readFileSync(path.join(CACHE, "quota.json"), "utf8"))[name];
      if (q) {
        console.log("  observed upstream limit (" + q.at + "):");
        console.log("    status " + q.status + (q.model ? "  model " + q.model : "") + (q.limit != null ? "  limit " + q.limit : "") + (q.quotaId ? "  " + q.quotaId : ""));
        if (q.kind) console.log("    kind " + q.kind + (q.classes ? " (" + q.classes.join(", ") + ")" : "") +
          (q.kind === "burst" ? " - transient, the gateway retries these" : " - terminal for the day, the gateway fails fast"));
        console.log("    " + q.message.slice(0, 200));
      } else console.log("  no quota observations yet (limits are read from real 429/503 responses)");
    } catch (e) { }
    break;
  }
  case "nararouter": {
    const sub = args[0] || "usage";
    if (sub === "plans" || sub === "usage") {
      const cache = readNaraCache() || {};
      const plans = cache.plans || await naraFetchPlans();
      writeNaraCache({ ...cache, plans, plansAt: new Date().toISOString() });
      if (args.includes("--json")) { console.log(JSON.stringify(plans, null, 2)); break; }
      console.log(naraFormatUsage(plans, { active: args[1] || "free", observed: cache.observed || null }));
      break;
    }
    console.log("usage: cc-termux nararouter [usage|plans] [plan] [--json]");
    break;
  }
  case "web": {
    const activeIsAntigravity = () => {
      try {
        const c = load();
        return ((c.providers || {})[c.active] || {}).type === "antigravity";
      } catch (e) { return false; }
    };
    const sub = (args[0] || "status").toLowerCase();
    const cfg = readWebConfig();
    cfg.keys = cfg.keys || {};
    if (sub === "status" || sub === "list") {
      const chain = resolveChain("search", cfg, { antigravity: activeIsAntigravity() });
      console.log("web search providers (tried in order, then the built-in scraper):");
      chain.forEach((id, i) => {
        const info = PROVIDER_INFO[id];
        const has = webProviderKey(id, cfg);
        const state = id === "local" ? "always available"
          : id === "google" ? "Google index via Antigravity"
          : has ? "key saved" : info.needsKey ? "no key (skipped)" : "no key (keyless mode)";
        console.log("  " + String(i + 1).padStart(2) + ". " + info.label.padEnd(28) + state);
      });
      console.log();
      console.log("set a key:  cc-termux web key <tavily|brave|jina> <key>");
      console.log("clear one:  cc-termux web clear <tavily|brave|jina>");
      console.log("test:       cc-termux web test [query]");
      console.log("also in env: " + WEB_PROVIDERS.filter((id) => PROVIDER_INFO[id].env).map((id) => PROVIDER_INFO[id].env).join(", "));
      break;
    }
    if (sub === "key") {
      const id = String(args[1] || "").toLowerCase();
      const value = args.slice(2).join(" ").trim();
      if (!PROVIDER_INFO[id] || id === "local") { console.error("unknown provider: " + (args[1] || "(none)") + "  (use tavily, brave or jina)"); process.exit(1); }
      if (!value) { console.error("usage: cc-termux web key " + id + " <key>"); process.exit(1); }
      cfg.keys[id] = value;
      writeWebConfig(cfg);
      console.log("saved " + PROVIDER_INFO[id].label + " key");
      break;
    }
    if (sub === "clear") {
      const id = String(args[1] || "").toLowerCase();
      if (!cfg.keys[id]) { console.log("no " + (id || "key") + " key stored"); break; }
      delete cfg.keys[id];
      writeWebConfig(cfg);
      console.log("cleared " + id);
      break;
    }
    if (sub === "test") {
      const q = args.slice(1).join(" ").trim() || "termux package management";
      const chain = resolveChain("search", cfg, { antigravity: activeIsAntigravity() }).filter((id) => id !== "local");
      console.log("query: " + q);
      console.log("chain: " + (chain.join(" -> ") || "(none - built-in scraper only)"));
      const out = await searchChain(q, { chain, maxResults: 3, cfg, localSearch: null }).catch((e) => ({ rows: [], attempts: [{ provider: "?", status: "error", message: e.message }] }));
      for (const a of out.attempts) console.log("  " + a.provider + ": " + a.status + (a.count ? " (" + a.count + ")" : "") + (a.message ? " - " + a.message : ""));
      if (out.rows.length) { console.log(); out.rows.slice(0, 3).forEach((r, i) => console.log("  " + (i + 1) + ". " + r.title + "\n     " + r.url)); }
      break;
    }
    console.log("usage: cc-termux web [status|key <name> <key>|clear <name>|test [query]]");
    break;
  }
  case "presets": {
    const p = JSON.parse(fs.readFileSync(path.join(ROOT, "presets.json"), "utf8"));
    const list = p.free || [];
    if (args.includes("--json")) { console.log(JSON.stringify(list, null, 2)); break; }
    for (const x of list) console.log(x.id.padEnd(16) + x.name.padEnd(34) + (x.local ? "(local) " : "") + (x.noKey ? "(no key)" : "") + "  " + x.baseUrl);
    console.log("\nadd one: cc-termux setup -> 3   (or CC_SETUP_NONINTERACTIVE=1 CC_SETUP_PRESET=<id> for scripted)");
    break;
  }
  case "diagnose": {
    await diagnose();
    break;
  }
  case "errors": {
    const f = path.join(CACHE, "errors.log");
    if (!fs.existsSync(f)) { console.log("no failures logged"); break; }
    const n = Number(args[0]) || 20;
    const lines = fs.readFileSync(f, "utf8").trim().split("\n").slice(-n);
    for (const line of lines) {
      try {
        const r = JSON.parse(line);
        console.log(r.at + "  " + r.kind.padEnd(9) + "  " + String(r.provider || "-").padEnd(10) + "  " + String(r.model || "-").padEnd(30) + "  " + (r.status == null ? "" : r.status + "  ") + r.message.slice(0, 140));
      } catch (e) { console.log(line); }
    }
    break;
  }
  case "antigravity": {
    const sub = args[0] || "status";
    if (!["login", "status", "logout", "refresh", "usage", "models"].includes(sub)) { console.log("usage: cc-termux antigravity [login|status|logout|usage|models]"); break; }
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-antigravity.mjs"), sub === "refresh" ? "status" : sub], { stdio: "inherit" });
    if ((sub === "login" || sub === "logout" || sub === "usage") || (sub === "models" && args.includes("--update"))) refreshStatusLineFile();
    break;
  }
  case "statusline": {
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-statusline.mjs"), ...args], { stdio: "inherit" });
    break;
  }
  case "heal": {
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-heal.mjs"), "--root", ROOT], { stdio: "inherit" });
    break;
  }
  case "tune": {
    const mode = (args[0] || "status").toLowerCase();
    const allowed = { on: "on", mobile: "on", off: "off", normal: "off", auto: "off", status: "status" };
    if (!(mode in allowed)) { console.log("usage: cc-termux tune [on|off|auto|status]"); break; }
    const c = load();
    const prevPerf = { ...(c.performance || {}) };
    if (mode !== "status") c.performance = { ...prevPerf, mode: allowed[mode] };
    let perfMod;
    try { perfMod = await import("file://" + path.join(ROOT, "bin", "cc-perf.mjs")); }
    catch (e) { console.log("performance module is missing - run: cc-termux update"); break; }
    const r = perfMod.resolvePerf({ mode: (c.performance && c.performance.mode) || "off" });
    const cjPath = path.join(os.homedir(), ".claude.json");
    let cj = {};
    try { cj = JSON.parse(fs.readFileSync(cjPath, "utf8")); } catch { cj = {}; }
    if (mode !== "status") {
      if (r.enabled) {
        if (prevPerf.prevReducedMotion === undefined) c.performance.prevReducedMotion = cj.prefersReducedMotion === true;
        perfMod.setReducedMotion(os.homedir(), true);
      } else {
        const restore = prevPerf.prevReducedMotion;
        perfMod.setReducedMotion(os.homedir(), restore === true);
        delete c.performance.prevReducedMotion;
      }
    }
    save(c);
    console.log("Performance mode: " + (r.enabled ? "ON" : "OFF") + (r.enabled ? "  (chosen by you)" : ""));
    if (r.enabled) {
      console.log("  reduced motion: on");
      console.log("  flags: " + Object.keys(perfMod.PERF_ENV).join(", "));
    }
    if (mode !== "status") console.log("  restart running claude sessions to apply");
    break;
  }
  default:
    console.log(HELP);
}