#!/usr/bin/env node
// Control CLI: providers, models, keys, diagnostics, patches.

import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { execFileSync } from "node:child_process";

const ROOT = process.env.CC_TERMUX_ROOT || path.join(os.homedir(), ".local", "share", "cc-termux");
const CFG = process.env.CC_TERMUX_CONFIG || path.join(os.homedir(), ".config", "cc-termux", "config.json");
const CATALOG = path.join(os.homedir(), ".cache", "cc-termux", "catalog.json");
function refreshStatusLineFile() {
  try { execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-statusline.mjs"), "--refresh"], { stdio: "ignore", timeout: 6000 }); } catch (e) { }
}
function atomicWrite(file, text, mode = 0o600) {
  const tmp = file + "." + process.pid + ".tmp";
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(tmp, text, { mode });
  fs.renameSync(tmp, file);
  try { fs.chmodSync(file, mode); } catch (e) { }
}
const load = () => {
  try { return JSON.parse(fs.readFileSync(CFG, "utf8")); }
  catch (e) { return { version: 1, providers: {}, active: "", routing: {} }; }
};
const save = (c) => { atomicWrite(CFG, JSON.stringify(c, null, 2) + "\n", 0o600); };
const port = (c) => (c.listen && c.listen.port) || 8788;
const KEYS_PATH = path.join(path.dirname(CFG), 'keys.json');
const loadKeys = () => { try { return JSON.parse(fs.readFileSync(KEYS_PATH, 'utf8')); } catch { return {}; } };
const saveKeys = (k) => { atomicWrite(KEYS_PATH, JSON.stringify(k, null, 2) + '\n', 0o600); };
const mask = (k) => !k ? "(not set)" : k.startsWith("env:") ? k : "set (ends " + k.slice(-4) + ")";

const SETTINGS_PATH = path.join(os.homedir(), ".claude", "settings.json");
const visibleProviders = (c) => Object.entries(c.providers || {}).filter(([, p]) => !p.hidden);
const composite = (p, id) => (id ? "prov/" + p + "/" + id : id);
const fmtCtx = (n) => (!n ? "?" : n >= 1e6 ? (n / 1e6).toFixed(n % 1e6 ? 1 : 0) + "M" : n >= 1e3 ? Math.round(n / 1e3) + "K" : String(n));

function rebuild(c) {
  c.routing = {};
  for (const [name, p] of visibleProviders(c)) {
    for (const id of Object.keys(p.modelsById || {})) {
      const native = id.startsWith("claude-") || id.startsWith("anthropic/");
      c.routing[composite(name, id)] = ((native && c.providers[name + "~native"]) ? name + "~native" : name) + "::" + id;
    }
  }
}
function writePicker(c) {
  let settings = {};
  try { settings = JSON.parse(fs.readFileSync(SETTINGS_PATH, "utf8")); } catch (e) { settings = {}; }
  const switchRows = visibleProviders(c).map(([name, p]) => ({
    model: "provswitch/" + name,
    label: "\u21c4  Switch to " + name,
    description: "use " + (p.model || "default") + " \u00b7 " + p.type + (name === c.active ? " \u00b7 current" : ""),
  }));
  const options = [];
  for (const [name, p] of visibleProviders(c)) {
    for (const [id, info] of Object.entries(p.modelsById || {})) {
      const isActive = name === c.active && id === (p.model || p.defaultModel);
      options.push({
        model: composite(name, id),
        label: (info.name && info.name !== id ? info.name : id) + "  [" + name + "]",
        description: (info.contextTokens ? fmtCtx(info.contextTokens) + " ctx" : "ctx unknown") +
          (info.inUsd == null ? "" : " - $" + info.inUsd + " in / $" + info.outUsd + " out per Mtok") +
          (isActive ? " - current" : ""),
      });
    }
  }
  settings.modelPicker = { replaceBuiltInOptions: true, options: [...switchRows, ...options] };
  fs.mkdirSync(path.dirname(SETTINGS_PATH), { recursive: true });
  fs.writeFileSync(SETTINGS_PATH, JSON.stringify(settings, null, 2) + "\n");
  return { switchRows, options };
}

function antigravityState() {
  try {
    const f = path.join(path.dirname(CFG), "antigravity.json");
    const c = JSON.parse(fs.readFileSync(f, "utf8"));
    if (c && c.access_token) return { ok: true, detail: "OAuth" + (c.email ? " " + c.email : "") + (c.project_id ? " · project " + c.project_id : "") };
    return { ok: false, detail: "not logged in (run: cc-termux antigravity login)" };
  } catch (e) { return { ok: false, detail: "not logged in (run: cc-termux antigravity login)" }; }
}

async function doctor(fix) {
  const c = load();
  const settingsPath = SETTINGS_PATH;
  const ks = loadKeys();
  const lines = [];
  let issues = 0, fixed = 0;
  const pass = (m) => lines.push("  \u2714 " + m);
  const warn = (m) => { issues++; lines.push("  \u26a0 " + m); };
  const fail = (m) => { issues++; lines.push("  \u2716 " + m); };

  lines.push("cc-termux doctor" + (fix ? "  (--fix)" : ""));
  const vis = visibleProviders(c);
  if (!vis.length) fail("no providers configured (run: cc-termux setup)"); else pass(vis.length + " provider(s): " + vis.map(([n]) => n).join(", "));

  for (const [name, p] of vis) {
    if (p.type === "antigravity") {
      const st = antigravityState();
      if (!st.ok) fail("provider " + name + ": " + st.detail); else pass("provider " + name + ": " + st.detail);
    } else if (!p.noKey && !ks[name] && !p.apiKeyEnv) {
      fail("provider " + name + " has no API key (cc-termux key " + name + " <key>)");
    }
    const mc = Object.keys(p.modelsById || {}).length;
    if (!mc) warn("provider " + name + " has no cached models (run: cc-termux setup)");
    else pass("provider " + name + ": " + p.model + "  (" + mc + " models, retries " + (p.retries || 5) + ")");
  }

  try {
    const pids = [];
    for (const d of fs.readdirSync("/proc")) {
      if (!/^\d+$/.test(d)) continue;
      try {
        const cmd = fs.readFileSync("/proc/" + d + "/cmdline", "utf8");
        if (cmd.includes("proxy/server.mjs") && Number(d) !== process.pid) pids.push(Number(d));
      } catch (e) { }
    }
    if (pids.length > 1) warn(pids.length + " gateway processes running (run: cc-termux restart)");
  } catch (e) { }
  const portv = (c.listen && c.listen.port) || 8788;
  let health = null;
  try { health = await (await fetch("http://127.0.0.1:" + portv + "/health")).json(); } catch (e) {}
  if (health && health.ok) pass("gateway up on " + portv + " (active: " + health.active + ")");
  else warn("gateway not running (starts automatically on next claude run)");

  let settings = {};
  try { settings = JSON.parse(fs.readFileSync(settingsPath, "utf8")); } catch (e) {}
  const active = c.providers[c.active] || {};
  const wantModel = composite(c.active, active.model || active.defaultModel);
  const sm = settings.model || "";
  const smProv = (sm.match(/^prov\/([^/]+)\//) || [])[1];
  if (!sm) warn("settings.model is not set (default model falls back to aliases)");
  else if (sm.startsWith("provswitch/")) {
    if (fix && wantModel) { settings.model = wantModel; fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + "\n"); fixed++; pass("settings.model was a switch marker; set to " + wantModel); }
    else warn("settings.model is a provider-switch marker (" + sm + ")");
  } else if (smProv && !c.providers[smProv]) warn("settings.model points to removed provider " + smProv);
  else pass("settings.model: " + sm);

  const activeP = c.providers[c.active] || {};
  const expectedModel = c.active && activeP.model ? "prov/" + c.active + "/" + activeP.model : "";
  const sm2 = settings.model || "";
  const bare = /^claude-(opus|sonnet|haiku)-[0-9]/.test(sm2) && !sm2.startsWith("prov/");
  if (expectedModel && (!sm2 || bare)) {
    if (fix) { settings.model = expectedModel; fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + "\n"); fixed++; pass("settings.model set to " + expectedModel); }
    else warn("settings.model is " + (sm2 || "empty") + " - should be " + expectedModel + " (doctor --fix)");
  }
  {
    const rc = resolvedClaude();
    if (!rc) warn("no claude command on PATH (re-run the installer)");
    else if (!isOurShim(rc)) {
      const others = claudeCandidates().filter((p) => !isOurShim(p));
      if (fix) {
        for (const p of others) {
          try {
            fs.renameSync(p, p + ".official-backup");
            fs.writeFileSync(p, "#!/bin/sh\nexec \"" + process.execPath + "\" \"" + path.join(ROOT, "bin", "cc-launcher.mjs") + "\" \"$@\"\n");
            fs.chmodSync(p, 0o755);
            fixed++;
          } catch (e) { }
        }
        pass("replaced foreign claude binary with the cc-termux shim (" + others.join(", ") + ")");
      } else warn("claude resolves to " + rc + " (official install, not the cc-termux shim) - doctor --fix replaces it");
    } else pass("claude resolves to the cc-termux shim");
  }
  const envKeys = Object.keys((settings.env) || {}).filter((k) => /^ANTHROPIC_/.test(k) || k === "CLAUDE_CODE_MAX_CONTEXT_TOKENS");
  if (envKeys.length) {
    if (fix) {
      for (const k of envKeys) delete settings.env[k];
      fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + "\n");
      fixed++; pass("removed conflicting settings.env keys: " + envKeys.join(", "));
    } else warn("settings.env overrides the launcher: " + envKeys.join(", ") + " (doctor --fix)");
  }
  const projCfgs = [path.join(process.cwd(), ".claude", "settings.json"), path.join(process.cwd(), ".claude", "settings.local.json")];
  for (const f of projCfgs) {
    if (path.resolve(f) === path.resolve(settingsPath)) continue;
    try {
      const ps = JSON.parse(fs.readFileSync(f, "utf8"));
      if (ps.model) warn("project settings set model: " + ps.model + "  (" + f + ")");
      const pe = Object.keys(ps.env || {}).filter((k) => /^ANTHROPIC_|^CLAUDE_CODE_MAX_CONTEXT/.test(k));
      if (pe.length) warn("project settings env overrides: " + pe.join(", ") + "  (" + f + ")");
    } catch (e) { }
  }
  const expected = vis.length + vis.reduce((n, [, p]) => n + Object.keys(p.modelsById || {}).length, 0);
  const have = ((settings.modelPicker || {}).options || []).length;
  if (have === expected) pass("model picker in sync (" + have + " rows)");
  else if (fix) { const r = writePicker(c); fixed++; pass("picker rebuilt: " + r.switchRows.length + " switch rows + " + r.options.length + " models"); }
  else fail("picker out of sync: has " + have + " rows, expected " + expected + " (cc-termux sync-picker)");

  const ov = c.override;
  if (ov) {
    const p = c.providers[ov.provider];
    const okModel = p && (!p.modelsById || !Object.keys(p.modelsById).length || p.modelsById[ov.model] || ov.model === p.model);
    if (!p) { if (fix) { delete c.override; save(c); fixed++; pass("removed invalid override"); } else warn("override points to missing provider " + ov.provider); }
    else if (!okModel) { if (fix) { c.override = { provider: ov.provider, model: p.model }; save(c); fixed++; pass("override model repaired to " + p.model); } else warn("override model " + ov.model + " is not in the catalog"); }
    else pass("override: " + ov.provider + " -> " + (ov.model || "default"));
  }

  const gem = vis.find(([n, p]) => n === "gemini" || /generativelanguage/.test(p.baseUrl || ""));
  if (gem) {
    const badIds = Object.keys(gem[1].modelsById || {}).filter((id) => /tts|embedding|imagen|veo|live|aqa|native-audio/i.test(id));
    if (!badIds.length) pass("gemini catalog has no non-chat models");
    else if (fix) { for (const id of badIds) delete gem[1].modelsById[id]; rebuild(c); save(c); writePicker(c); fixed++; pass("pruned " + badIds.length + " non-chat gemini models"); }
    else warn(badIds.length + " non-chat gemini models in picker (cc-termux doctor --fix)");
  }

  try {
    const out = execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-patch.mjs"), "--status"], { encoding: "utf8" });
    const applied = (out.match(/applied/g) || []).length;
    const pending = (out.match(/pending/g) || []).length;
    if (pending) warn(pending + " TUI patches pending (cc-termux patch)"); else pass("TUI patches applied (" + applied + ")");
  } catch (e) { warn("could not read patch status"); }

  const ccpPath = (process.env.PREFIX || "/data/data/com.termux/files/usr") + "/bin/ccp";
  if (fs.existsSync(ccpPath)) pass("ccp picker installed"); else warn("ccp not installed (run install.sh)");
  try {
    const log = path.join(os.homedir(), ".cache", "cc-termux", "gateway.log");
    const tail = fs.readFileSync(log, "utf8").split("\n").slice(-300).join("\n");
    let qc = {}; try { qc = JSON.parse(fs.readFileSync(path.join(os.homedir(), ".cache", "cc-termux", "quota.json"), "utf8")); } catch (e) { }
    for (const [provider, q] of Object.entries(qc)) {
      const age = Date.now() - new Date(q.at).getTime();
      if (age < 7 * 24 * 3600 * 1000) warn("provider " + provider + ": recent " + q.status + (q.limit != null ? " (limit " + q.limit + ")" : "") + " at " + q.at);
    }
  } catch (e) { }
  const deny = (settings.permissions && settings.permissions.deny) || [];
  if (deny.length >= 4) pass("secret deny rules: " + deny.length); else warn("secret deny rules missing (re-run install.sh)");

  try {
    const log = path.join(os.homedir(), ".cache", "cc-termux", "gateway.log");
    const sz = fs.statSync(log).size;
    if (sz > 5 * 1024 * 1024) { if (fix) { fs.writeFileSync(log, ""); fixed++; pass("gateway.log truncated (" + (sz / 1e6).toFixed(1) + " MB)"); } else warn("gateway.log is " + (sz / 1e6).toFixed(1) + " MB (--fix truncates)"); }
    else pass("gateway.log " + (sz / 1024).toFixed(0) + " KB");
  } catch (e) {}

  console.log(lines.join("\n"));
  console.log("");
  console.log(issues === 0 ? "all checks passed" : issues + " issue(s)" + (fix ? ", " + fixed + " fixed" : " (run: cc-termux doctor --fix)"));
}
function claudeCandidates() {
  const dirs = String(process.env.PATH || '').split(path.delimiter).filter(Boolean);
  const out = [];
  for (const d of dirs) {
    const p = path.join(d, process.platform === 'win32' ? 'claude.cmd' : 'claude');
    try { if (fs.existsSync(p)) out.push(p); } catch (e) { }
  }
  return [...new Set(out)];
}
function isOurShim(p) {
  try { return /cc-launcher\.mjs/.test(fs.readFileSync(p, 'utf8')); } catch (e) { return false; }
}
function resolvedClaude() {
  const c = claudeCandidates();
  return c.length ? c[0] : null;
}
async function checkProviderKey(name, p) {
  if (p.type === "antigravity") return antigravityState();
  if (p.noKey) return { ok: true, detail: 'no key required' };
  const key = loadKeys()[name];
  if (!key) return { ok: false, detail: 'no key stored' };
  const timeout = (ms) => AbortSignal.timeout(ms);
  try {
    if (/generativelanguage/.test(p.baseUrl || '')) {
      const r = await fetch('https://generativelanguage.googleapis.com/v1beta/models?key=' + encodeURIComponent(key), { signal: timeout(8000) });
      return r.ok ? { ok: true, detail: 'models endpoint 200' } : { ok: false, detail: 'models endpoint HTTP ' + r.status };
    }
    const base = String(p.baseUrl).replace(/\/$/, '');
    const urls = [...new Set([base + '/models', base.replace(/\/v1.*$/, '') + '/v1/models', base + '/v1/models'])];
    let last = '';
    for (const u of urls) {
      try {
        const r = await fetch(u, { headers: { authorization: 'Bearer ' + key }, signal: timeout(8000) });
        if (r.ok) return { ok: true, detail: u.replace(/^https?:\/\//, '').slice(0, 60) + ' 200' };
        last = 'HTTP ' + r.status + ' @ ' + u.replace(/^https?:\/\//, '').slice(0, 50);
      } catch (e) { last = e.name || e.code; }
    }
    return { ok: false, detail: last || 'unreachable' };
  } catch (e) { return { ok: false, detail: e.name || e.code }; }
}
async function diagnose() {
  const c = (() => { try { return load(); } catch (e) { return null; } })();
  const hdr = (s) => console.log("\n" + s);
  hdr("cc-termux diagnose");
  console.log("  node      " + process.version + "  " + process.platform + "/" + process.arch);
  console.log("  root      " + ROOT + "  exists=" + fs.existsSync(ROOT));
  console.log("  config    " + CFG + "  exists=" + fs.existsSync(CFG));
  if (!c) console.log("  config    INVALID JSON");
  else {
    const vis = Object.entries(c.providers || {}).filter(([, p]) => !p.hidden);
    const ks = loadKeys();
    console.log("  providers " + (vis.length ? vis.map(([n, p]) => n + "(" + (p.type === "antigravity" ? "OAuth" : p.noKey ? "no key" : (ks[n] ? "key" : "no key")) + ")").join(", ") : "none"));
    console.log("  active    " + (c.active || "(none)") + "  override=" + JSON.stringify(c.override || null));
  {
    const rc = resolvedClaude();
    console.log("  claude    " + (rc || "(not found on PATH)") + (rc ? (isOurShim(rc) ? "  [our shim]" : "  [NOT ours - official install?]") : ""));
    for (const p of claudeCandidates().slice(1)) console.log("            also: " + p + (isOurShim(p) ? " [ours]" : " [not ours]"));
  }
  try {
    const st = JSON.parse(fs.readFileSync(path.join(os.homedir(), ".claude", "settings.json"), "utf8"));
    console.log("  settings  model=" + (st.model || "(none)"));
    const ek = Object.keys(st.env || {}).filter((k) => /^ANTHROPIC_|^CLAUDE_CODE_MAX_CONTEXT/.test(k));
    if (ek.length) console.log("  settings  env overrides=" + ek.join(", "));
  } catch (e) { console.log("  settings  (unreadable)"); }
    console.log("  port      " + ((c.listen && c.listen.port) || 8788));
  }
  if (c) {
    for (const [name, p] of Object.entries(c.providers || {}).filter(([, q]) => !q.hidden)) {
      const res = await checkProviderKey(name, p);
      console.log("  key " + name.padEnd(12) + (res.ok ? "OK   " : "FAIL ") + res.detail);
    }
  }
  const bin = path.join(ROOT, "bin", process.platform === "win32" ? "claude.exe" : "claude.bin");
  let bstat = null; try { bstat = fs.statSync(bin); } catch (e) {}
  console.log("  binary    " + bin + (bstat ? "  " + (bstat.size / 1e6).toFixed(1) + " MB" : "  MISSING"));
  if (!bstat) {
    console.log("  next      install Claude Code: cc-termux update");
    return;
  }
  console.log("  direct    " + fs.existsSync(path.join(ROOT, ".direct-exec")));
  try { console.log("  loader    " + fs.readdirSync(path.join(ROOT, "lib")).join(", ")); } catch (e) { console.log("  loader    none"); }
  console.log("  LD_PRELOAD " + (process.env.LD_PRELOAD || "(none)"));
  for (const k of ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"]) if (process.env[k]) console.log("  " + k + " " + process.env[k]);
  const port = (c && c.listen && c.listen.port) || 8788;
  let health = null;
  try { health = await (await fetch("http://127.0.0.1:" + port + "/health", { signal: AbortSignal.timeout(1500) })).json(); } catch (e) {}
  let pids = [];
  try {
    for (const d of fs.readdirSync("/proc")) {
      if (!/^\d+$/.test(d)) continue;
      try { const cmd = fs.readFileSync("/proc/" + d + "/cmdline", "utf8"); if (cmd.includes("proxy/server.mjs") && Number(d) !== process.pid) pids.push(Number(d)); } catch (e) {}
    }
  } catch (e) {}
  console.log("  gateway   " + (health ? "UP active=" + health.active : "DOWN") + "  pids=" + JSON.stringify(pids));
  if (!health) {
    hdr("gateway start attempt");
    const { spawn } = await import("node:child_process");
    const child = spawn(process.execPath, [path.join(ROOT, "proxy", "server.mjs")], { env: { ...process.env, CC_TERMUX_CONFIG: CFG }, stdio: ["ignore", "pipe", "pipe"] });
    let buf = ""; child.stdout.on("data", (d) => buf += d); child.stderr.on("data", (d) => buf += d);
    let started = false;
    for (let i = 0; i < 30; i++) {
      try { health = await (await fetch("http://127.0.0.1:" + port + "/health", { signal: AbortSignal.timeout(500) })).json(); started = true; break; } catch (e) {}
      await new Promise((r) => setTimeout(r, 100));
    }
    console.log("  started: " + (started ? "yes" : "no"));
    if (buf.trim()) console.log((buf.trim()).split("\n").slice(-8).join("\n"));
    try { child.kill(); } catch (e) {}
  }
  hdr("hints");
  if (!c || !Object.keys(c.providers || {}).length) console.log("  - no provider configured: run: cc-termux setup");
  if (process.env.HTTP_PROXY || process.env.HTTPS_PROXY) console.log("  - proxy env is set; add 127.0.0.1 to NO_PROXY");
  if (!bstat) console.log("  - binary missing: re-run the installer");
  if (pids.length > 1) console.log("  - duplicate gateways: cc-termux restart");
}

const cmd = process.argv[2];
const args = process.argv.slice(3);

const HELP = [
  "cc-termux \u2014 Claude Code with any provider",
  "",
  "Getting started",
  "  setup                 interactive provider wizard (OpenRouter, Gemini, Antigravity, local...)",
  "  status                dashboard: gateway, active provider/model, quotas",
  "  doctor [--fix]        self-check install, config, picker, secrets",
  "  test [prompt]         headless request through the gateway",
  "",
  "Providers & models",
  "  provider [name|list]  list or switch provider",
  "  models [--all]        model catalog with context window and price",
  "  use <model-id>        switch model and aliases",
  "  key <provider> <key>  store an API key",
  "  presets [--json]      built-in provider presets",
  "  sync-picker           rebuild the /model picker",
  "  sync                  refresh context windows and prices",
  "",
  "Google Antigravity",
  "  antigravity login     Google OAuth login",
  "  antigravity usage     live 5h/weekly quota",
  "  antigravity models --update   refresh models from Google",
  "  statusline [--install]        Claude Code status line (model + quota)",
  "",
  "Maintenance",
  "  update [--check]      update cc-termux (and Claude Code when needed)",
  "  update-claude         reinstall latest Claude Code binary",
  "  patch [status|revert] inspect or revert TUI patches",
  "  heal                  auto-repair PATH/settings",
  "  restart               stop the gateway (restarts on next run)",
  "  logs / errors [n]     gateway log / recent failures",
  "  diagnose              deep install + gateway check",
  "  tune [on|off]         performance mode for phones",
  "  path                  print install/config paths",
  "",
  "Run cc-termux <command> --help where available.",
].join("\n");

function decode(s) {
  return s.replace(/<[^>]+>/g, " ").replace(/&amp;/g, "&").replace(/&nbsp;/g, " ").replace(/&#x27;/g, "'").replace(/\s+/g, " ").trim();
}
function ctxTokens(s) {
  const m = String(s || "").match(/^([\d.]+)\s*([KMG])$/i);
  if (!m) return null;
  const mult = { K: 1e3, M: 1e6, G: 1e9 }[m[2].toUpperCase()];
  return Math.round(parseFloat(m[1]) * mult);
}

async function fetchCatalog() {
  const r = await fetch("https://tokens.bd/models");
  const html = await r.text();
  const rows = html.split("<tr").slice(1);
  const models = [];
  for (const row of rows) {
    const cells = [...row.matchAll(/<td[^>]*>([\s\S]*?)<\/td>/g)].map(m => decode(m[1]));
    if (cells.length < 6) continue;
    const idm = cells[1].match(/([A-Za-z0-9][A-Za-z0-9._-]*\/[A-Za-z0-9._-]+|[a-z0-9][a-z0-9._-]{4,})$/);
    if (!idm) continue;
    const id = idm[1];
    const name = cells[1].slice(0, cells[1].length - id.length).trim();
    const ctx = cells[3];
    const inUsd = parseFloat((cells[4] || "").replace(/[^0-9.]/g, ""));
    const outUsd = parseFloat((cells[5] || "").replace(/[^0-9.]/g, ""));
    models.push({ id, name, provider: cells[2], context: ctx, contextTokens: ctxTokens(ctx), inUsd, outUsd, plans: cells[6] });
  }
  const r2 = await fetch("https://tokens.bd/v1/models", { headers: { authorization: "Bearer " + keyFor() } }).catch(() => null);
  let usable = null;
  if (r2 && r2.ok) { try { const j = await r2.json(); usable = new Set((j.data || j || []).map(m => m.id)); } catch {} }
  for (const m of models) m.usable = usable ? usable.has(m.id) : null;
  const out = { fetchedAt: new Date().toISOString(), models };
  fs.mkdirSync(path.dirname(CATALOG), { recursive: true });
  fs.writeFileSync(CATALOG, JSON.stringify(out, null, 1));
  return out;
}

function keyFor() {
  const c = load();
  const p = c.providers[c.active] || {};
  if (p.apiKey) return p.apiKey.startsWith("env:") ? (process.env[p.apiKey.slice(4)] || "") : p.apiKey;
  return p.apiKeyEnv ? (process.env[p.apiKeyEnv] || "") : "";
}

async function catalog(force) {
  if (!force && fs.existsSync(CATALOG)) {
    const c = JSON.parse(fs.readFileSync(CATALOG, "utf8"));
    if (Date.now() - new Date(c.fetchedAt).getTime() < 6 * 3600 * 1000) return c;
  }
  return await fetchCatalog();
}

async function health() {
  try {
    const c = load();
    const r = await fetch("http://127.0.0.1:" + port(c) + "/health");
    return await r.json();
  } catch { return null; }
}

switch (cmd) {
  case "status": {
    const c = load();
    const h = await health();
    const color = (code, s) => process.stdout.isTTY ? "\x1b[" + code + "m" + s + "\x1b[0m" : s;
    const dim = (s) => color("2", s);
    const bold = (s) => color("1", s);
    const strip = (s) => String(s).replace(/\x1b\[[0-9;]*m/g, "");
    const pad = (s, n) => strip(s).padEnd(n);
    let stamp = {};
    try { stamp = JSON.parse(fs.readFileSync(path.join(ROOT, "cc-termux.json"), "utf8")); } catch (e) { }
    const active = c.providers && c.providers[c.active];
    const activeModel = active && (active.modelsById && active.modelsById[active.model] ? active.modelsById[active.model].name : active.model || active.defaultModel || "-");
    const keyState = active ? (active.type === "antigravity" ? "OAuth" : active.noKey ? "no key" : ((loadKeys()[c.active] || active.apiKeyEnv) ? "key set" : "no key")) : "";
    console.log();
    console.log(bold("  cc-termux") + dim("  " + (stamp.version || "dev") + "  " + process.platform + " " + process.arch));
    console.log();
    console.log("  gateway   " + (h ? color("32", "● UP") + dim("  http://127.0.0.1:" + port(c)) : color("33", "○ DOWN") + dim("  starts automatically with claude")));
    console.log("  active    " + (c.active ? bold(c.active) + (active && active.type !== c.active ? dim("  " + active.type) : "") : dim("none")));
    console.log("  model     " + (activeModel || "-") + (active && active.contextWindow ? dim("  " + Math.round(active.contextWindow / 1000) + "K ctx") : "") + dim(keyState ? "  " + keyState : ""));
    try {
      const sf = path.join(os.homedir(), ".cache", "cc-termux", "antigravity-status.txt");
      if (active && active.type === "antigravity") {
        const line = fs.readFileSync(sf, "utf8").trim();
        if (line) console.log("  quota     " + line.replace(/^antigravity · [^·]+ · /, ""));
      }
    } catch (e) { }
    console.log();
    console.log(dim("  providers"));
    for (const [name, p] of Object.entries(c.providers || {})) {
      if (p.hidden) continue;
      const model = p.model || p.defaultModel || "-";
      const isActive = name === c.active;
      const marker = isActive ? color("32", "●") : dim("○");
      const key = p.type === "antigravity" ? "OAuth" : p.noKey ? "no key" : ((loadKeys()[name] || p.apiKeyEnv) ? "key set" : "no key");
      console.log("   " + marker + " " + pad(name, 15) + dim(pad(p.type, 12)) + pad(model, 32) + dim(key));
    }
    if (!Object.keys(c.providers || {}).filter((n) => !c.providers[n].hidden).length) {
      console.log(dim("   no providers yet - run: cc-termux setup"));
    }
    console.log();
    if (Object.keys(c.providers || {}).filter((n) => !c.providers[n].hidden).length) {
      console.log(dim("  next: ") + "claude" + dim("   |   /model to switch   |   /provider to switch provider   |   cc-termux doctor"));
    } else {
      console.log(dim("  next: ") + "cc-termux setup" + dim("   adds a provider (OpenRouter, Gemini, Antigravity, local...) "));
    }
    console.log();
    break;
  }
  case "provider": {
    const c = load();
    const settingsPath = path.join(os.homedir(), ".claude", "settings.json");
    const setDefaultModel = (composite) => {
      try {
        const s = fs.existsSync(settingsPath) ? JSON.parse(fs.readFileSync(settingsPath, "utf8")) : {};
        s.model = composite;
        fs.mkdirSync(path.dirname(settingsPath), { recursive: true });
        fs.writeFileSync(settingsPath, JSON.stringify(s, null, 2) + "\n");
      } catch (e) { console.error("could not update settings.json:", e.message); }
    };
    const composite = (name, model) => model ? "prov/" + name + "/" + model : model;
    if (args[0] === "--json") {
      const ks = loadKeys();
      const rows = Object.entries(c.providers || {}).filter(([, p]) => !p.hidden).map(([name, p]) => ({
        name, active: name === c.active, model: p.model || p.defaultModel || null, type: p.type, key: mask(ks[name] || ""),
      }));
      console.log(JSON.stringify(rows, null, 1));
      break;
    }
    if (!args[0] || args[0] === "list") {
      let shown = 0;
      for (const [name, p] of Object.entries(c.providers || {})) {
        if (p.hidden) continue;
        const model = p.model || p.defaultModel || "-";
        console.log((name === c.active ? " \u2714 " : "   ") + name.padEnd(14) + String(p.type).padEnd(10) + model + "  key=" + mask(loadKeys()[name] || (p.apiKeyEnv ? "env:" + p.apiKeyEnv : "")));
        shown++;
      }
      if (!shown) console.log("no providers configured - run: cc-termux setup");
      if (c.override) console.log("override: " + c.override.provider + " -> " + (c.override.model || "default"));
      break;
    }
    if (args[0] === "off") { delete c.override; save(c); refreshStatusLineFile(); console.log("override cleared; active provider: " + c.active); break; }
    const name = args[0];
    if (!c.providers[name]) { console.error("unknown provider:", name); console.error("known: " + Object.keys(c.providers || {}).join(", ")); process.exit(1); }
    const p = c.providers[name];
    c.active = name;
    c.override = { provider: name, model: p.model || p.defaultModel || null };
    save(c);
    refreshStatusLineFile();
    if (p.model) setDefaultModel(composite(name, p.model));
    console.log("active provider -> " + name + " (" + (p.model || p.defaultModel) + ")");
    console.log("the running Claude Code session switches on its next request");
    break;
  }
  case "key": {
    const c = load();
    const [name, key] = args;
    if (!name || !key) { console.error("usage: cc-termux key <provider> <key>"); process.exit(1); }
    if (!c.providers[name]) { console.error("unknown provider:", name); process.exit(1); }
    const ks = loadKeys(); ks[name] = key; saveKeys(ks);
    console.log("stored key for " + name + " in keys.json");
    break;
  }
  case "model":
  case "use": {
    const c = load();
    let id = args[0];
    if (!id) { console.error("usage: cc-termux use <model-id>   (see: cc-termux models)"); process.exit(1); }
    const cat = await catalog(false);
    const entry = cat.models.find(m => m.id === id);
    if (!entry) { console.error("model not found in catalog: " + id); process.exit(1); }
    const p = c.providers[c.active];
    p.model = entry.id;
    p.defaultModel = entry.id;
    p.contextWindow = entry.contextTokens || p.contextWindow || 128000;
    p.aliases = { opus: entry.id, sonnet: entry.id, haiku: entry.id, subagent: entry.id };
    save(c);
    console.log("active model -> " + entry.id + "  (" + entry.name + ", ctx " + entry.context + " = " + p.contextWindow + " tokens, $" + entry.inUsd + "/$" + entry.outUsd + " per 1M)");
    console.log("aliases opus/sonnet/haiku/subagent -> " + entry.id);
    console.log("restart Claude Code to apply.");
    break;
  }
  case "sync": {
    const cat = await catalog(true);
    console.log("catalog refreshed: " + cat.models.length + " models at " + cat.fetchedAt);
    break;
  }
  case "models": {
    const cat = await catalog(false);
    const list = cat.models.filter(m => args.includes("--all") || m.usable !== false);
    list.sort((a, b) => a.inUsd - b.inUsd || a.outUsd - b.outUsd);
    console.log("catalog " + cat.fetchedAt + "  (" + list.length + " models; usable by this key unless marked *)");
    console.log("id".padEnd(44) + "ctx".padEnd(8) + "in/1M".padEnd(9) + "out/1M".padEnd(9) + "availability");
    for (const m of list) {
      const mark = m.usable === false ? "*" : " ";
      console.log(mark + m.id.padEnd(43) + String(m.context).padEnd(8) + ("$" + m.inUsd).padEnd(9) + ("$" + m.outUsd).padEnd(9) + String(m.plans || ""));
    }
    break;
  }
  case "map": {
    const c = load();
    const [name, from, to] = args;
    if (!name || !from || !to) { console.error("usage: cc-termux map <provider> <claude-model> <upstream-model>"); process.exit(1); }
    if (!c.providers[name]) { console.error("unknown provider:", name); process.exit(1); }
    c.providers[name].models = c.providers[name].models || {};
    c.providers[name].models[from] = to; save(c);
    console.log(name + ": " + from + " -> " + to);
    break;
  }
  case "test": {
    const prompt = args.join(" ") || "Reply with exactly: GATEWAY OK";
    const out = execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-launcher.mjs"), "-p", "--output-format", "json", prompt], { encoding: "utf8", timeout: 180000 });
    try { const j = JSON.parse(out); console.log(j.result || JSON.stringify(j)); } catch { console.log(out); }
    break;
  }
  case "logs": {
    const f = path.join(os.homedir(), ".cache", "cc-termux", "gateway.log");
    console.log(fs.readFileSync(f, "utf8").split("\n").slice(-60).join("\n"));
    break;
  }
  case "restart": {
    const pidf = path.join(os.homedir(), ".cache", "cc-termux", "gateway.pid");
    try { process.kill(Number(fs.readFileSync(pidf, "utf8").trim())); } catch {}
    try {
      for (const d of fs.readdirSync("/proc")) {
        if (!/^\d+$/.test(d)) continue;
        try {
          const cmd = fs.readFileSync("/proc/" + d + "/cmdline", "utf8");
          if (cmd.includes("proxy/server.mjs") && Number(d) !== process.pid) process.kill(Number(d));
        } catch (e) { }
      }
    } catch (e) { }
    console.log("gateway stopped; restarts on the next claude run");
    break;
  }
  case "patch": {
    const sub = args[0] === "revert" ? "--revert" : args[0] === "status" ? "--status" : "--apply";
    execFileSync("node", [path.join(ROOT, "bin", "cc-patch.mjs"), sub], { stdio: "inherit" });
    break;
  }
  case "setup": {
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-setup.mjs"), ...args], { stdio: "inherit" });
    break;
  }
  case "update": {
    const sub = args[0] === "--check" ? "--check" : "--self-update";
    const extra = sub === "--self-update" && args.includes("--redownload") ? ["--redownload"] : [];
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-update.mjs"), sub, ...extra], { stdio: "inherit" });
    break;
  }
  case "path": {
    console.log("root   : " + ROOT);
    console.log("config : " + CFG);
    break;
  }
  case "doctor": {
    await doctor(args.includes("--fix"));
    break;
  }
  case "sync-picker": {
    const c = load();
    const r = writePicker(c);
    console.log("picker rebuilt: " + r.switchRows.length + " switch rows + " + r.options.length + " models");
    break;
  }
  case "usage": {
    const c = load();
    const name = args[0] || c.active;
    const p = c.providers[name];
    if (!p) { console.error("unknown provider:", name); process.exit(1); }
    const key = loadKeys()[name];
    if (!key) { console.error("no key stored for " + name); process.exit(1); }
    if (/tokens\.bd/.test(p.baseUrl || "")) {
      const r = await fetch("https://tokens.bd/v1/tokens/usage", { headers: { authorization: "Bearer " + key } });
      const j = await r.json();
      console.log("provider: " + name + "  plan: " + (j.plan && j.plan.name));
      for (const w of j.windows || []) console.log("  " + w.label + ": $" + Number(w.used).toFixed(4) + " / $" + w.limit + "  (" + w.percentUsed + "%)");
      if (j.key) console.log("  key: monthly cap $" + j.key.monthlySpendCapUsd);
      break;
    }
    console.log("provider: " + name + "  (" + p.baseUrl + ")");
    console.log("  no usage endpoint known for this provider");
    try {
      const q = JSON.parse(fs.readFileSync(path.join(os.homedir(), ".cache", "cc-termux", "quota.json"), "utf8"))[name];
      if (q) {
        console.log("  observed upstream limit (" + q.at + "):");
        console.log("    status " + q.status + (q.model ? "  model " + q.model : "") + (q.limit != null ? "  limit " + q.limit : "") + (q.quotaId ? "  " + q.quotaId : ""));
        console.log("    " + q.message.slice(0, 200));
      } else console.log("  no quota observations yet (limits are read from real 429/503 responses)");
    } catch (e) { }
    break;
  }
  case "presets": {
    const p = JSON.parse(fs.readFileSync(path.join(ROOT, "presets.json"), "utf8"));
    const list = p.free || [];
    if (args.includes("--json")) { console.log(JSON.stringify(list, null, 2)); break; }
    for (const x of list) console.log(x.id.padEnd(16) + x.name.padEnd(34) + (x.local ? "(local) " : "") + (x.noKey ? "(no key)" : "") + "  " + x.baseUrl);
    console.log("\nadd one: cc-termux setup -> 3   (or CC_SETUP_NONINTERACTIVE=1 CC_SETUP_PRESET=<id> for scripted)");
    break;
  }
  case "diagnose": {
    await diagnose();
    break;
  }
  case "errors": {
    const f = path.join(os.homedir(), ".cache", "cc-termux", "errors.log");
    if (!fs.existsSync(f)) { console.log("no failures logged"); break; }
    const n = Number(args[0]) || 20;
    const lines = fs.readFileSync(f, "utf8").trim().split("\n").slice(-n);
    for (const line of lines) {
      try {
        const r = JSON.parse(line);
        console.log(r.at + "  " + r.kind.padEnd(9) + "  " + String(r.provider || "-").padEnd(10) + "  " + String(r.model || "-").padEnd(30) + "  " + (r.status == null ? "" : r.status + "  ") + r.message.slice(0, 140));
      } catch (e) { console.log(line); }
    }
    break;
  }
  case "antigravity": {
    const sub = args[0] || "status";
    if (!["login", "status", "logout", "refresh", "usage", "models"].includes(sub)) { console.log("usage: cc-termux antigravity [login|status|logout|usage|models]"); break; }
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-antigravity.mjs"), sub === "refresh" ? "status" : sub], { stdio: "inherit" });
    if ((sub === "login" || sub === "logout" || sub === "usage") || (sub === "models" && args.includes("--update"))) refreshStatusLineFile();
    break;
  }
  case "statusline": {
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-statusline.mjs"), ...args], { stdio: "inherit" });
    break;
  }
  case "heal": {
    execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-heal.mjs"), "--root", ROOT], { stdio: "inherit" });
    break;
  }
  case "tune": {
    const mode = (args[0] || "status").toLowerCase();
    const allowed = { on: "on", mobile: "on", off: "off", normal: "off", auto: "off", status: "status" };
    if (!(mode in allowed)) { console.log("usage: cc-termux tune [on|off|auto|status]"); break; }
    const c = load();
    const prevPerf = { ...(c.performance || {}) };
    if (mode !== "status") c.performance = { ...prevPerf, mode: allowed[mode] };
    let perfMod;
    try { perfMod = await import("file://" + path.join(ROOT, "bin", "cc-perf.mjs")); }
    catch (e) { console.log("performance module is missing - run: cc-termux update"); break; }
    const r = perfMod.resolvePerf({ mode: (c.performance && c.performance.mode) || "off" });
    const cjPath = path.join(os.homedir(), ".claude.json");
    let cj = {};
    try { cj = JSON.parse(fs.readFileSync(cjPath, "utf8")); } catch { cj = {}; }
    if (mode !== "status") {
      if (r.enabled) {
        if (prevPerf.prevReducedMotion === undefined) c.performance.prevReducedMotion = cj.prefersReducedMotion === true;
        perfMod.setReducedMotion(os.homedir(), true);
      } else {
        const restore = prevPerf.prevReducedMotion;
        perfMod.setReducedMotion(os.homedir(), restore === true);
        delete c.performance.prevReducedMotion;
      }
    }
    save(c);
    console.log("Performance mode: " + (r.enabled ? "ON" : "OFF") + (r.enabled ? "  (chosen by you)" : ""));
    if (r.enabled) {
      console.log("  reduced motion: on");
      console.log("  flags: " + Object.keys(perfMod.PERF_ENV).join(", "));
    }
    if (mode !== "status") console.log("  restart running claude sessions to apply");
    break;
  }
  default:
    console.log(HELP);
}