#!/usr/bin/env node
// Control CLI: providers, models, keys, diagnostics, patches.

import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { execFileSync } from "node:child_process";
import { installRoot, configFile, claudeDir, cacheDir } from "./cc-paths.mjs";
import { fetchPlans as naraFetchPlans, formatUsage as naraFormatUsage, readNaraCache, writeNaraCache } from "./cc-nara.mjs";
import { WEB_PROVIDERS, PROVIDER_INFO, readWebConfig, writeWebConfig, providerKey as webProviderKey, resolveChain, searchChain } from "./cc-webproviders.mjs";

const ROOT = installRoot();
const CFG = configFile();
const CACHE = cacheDir();
const GATEWAY_PID_FILE = path.join(CACHE, "gateway.pid");
function readPidFile() {
  try {
    const pid = Number(fs.readFileSync(GATEWAY_PID_FILE, "utf8").trim());
    return Number.isInteger(pid) && pid > 0 ? pid : 0;
  } catch (e) { return 0; }
}
function forgetPidFile() { try { fs.unlinkSync(GATEWAY_PID_FILE); } catch (e) { } }
function pidAlive(pid) {
  // signal 0 only probes existence (Node docs: "a signal of 0 can be used to test for the
  // existence of a process"); EPERM still means the pid exists, just not ours.
  try { process.kill(pid, 0); return true; } catch (e) { return e.code === "EPERM"; }
}
function procCmdline(pid) {
  try { return fs.readFileSync("/proc/" + pid + "/cmdline", "utf8").replace(/\0/g, " ").trim(); }
  catch (e) { return null; }
}
async function gatewayHealthUp() {
  try {
    const r = await fetch("http://127.0.0.1:" + port(load()) + "/health", { signal: AbortSignal.timeout(1500) });
    const j = await r.json();
    return !!(j && j.ok);
  } catch (e) { return false; }
}
async function gatewayPids() {
  // /proc is Linux-only; macOS/Windows use the pid file the launcher writes. Whatever the
  // source, a pid is only reported once it is verified: a recycled or dead pid must never
  // make `restart` kill an unrelated process or `status`/doctor claim a gateway that is
  // not there.
  const hasProc = fs.existsSync("/proc/self/cmdline");
  const pids = [];
  if (hasProc) {
    try {
      for (const d of fs.readdirSync("/proc")) {
        if (!/^\d+$/.test(d)) continue;
        const pid = Number(d);
        if (pid === process.pid) continue;
        const cmd = procCmdline(pid);
        if (cmd && cmd.includes("proxy/server.mjs")) pids.push(pid);
      }
    } catch (e) { }
    if (pids.length) return pids;
  }
  const pid = readPidFile();
  if (!pid || pid === process.pid) return pids;
  const cmd = hasProc ? procCmdline(pid) : null;
  if (cmd != null) {
    // Linux: /proc is authoritative. A pid file that points at something else is stale.
    if (cmd.includes("proxy/server.mjs")) pids.push(pid);
    else forgetPidFile();
    return pids;
  }
  if (!pidAlive(pid)) { forgetPidFile(); return pids; }
  // No /proc to inspect (macOS, Windows): trust only a live pid whose own gateway health
  // endpoint answers. A live but silent pid is a recycled one - leave it alone.
  if (await gatewayHealthUp()) pids.push(pid);
  return pids;
}

const CATALOG = path.join(CACHE, "catalog.json");
function refreshStatusLineFile() {
  try { execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-statusline.mjs"), "--refresh"], { stdio: "ignore", timeout: 6000 }); } catch (e) { }
  try {
    const file = path.join(CACHE, "antigravity-status.txt");
    if (!fs.existsSync(file)) {
      const cfg = JSON.parse(fs.readFileSync(CFG, "utf8"));
      const prov = cfg.providers && cfg.providers[cfg.active];
      if (prov) {
        fs.mkdirSync(cache, { recursive: true });
        fs.writeFileSync(file, cfg.active + " · " + (prov.model || prov.defaultModel || prov.type) + NL);
      }
    }
  } catch (e) { }
}
function atomicWrite(file, text, mode = 0o600) {
  const tmp = file + "." + process.pid + ".tmp";
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(tmp, text, { mode });
  fs.renameSync(tmp, file);
  try { fs.chmodSync(file, mode); } catch (e) { }
}
// Always return a usable shape: a hand-written or half-broken config.json must not make
// the CLI throw a TypeError deep inside a command.
const normalizeConfig = (c) => {
  if (!c || typeof c !== "object" || Array.isArray(c)) c = {};
  c.providers = c.providers && typeof c.providers === "object" && !Array.isArray(c.providers) ? c.providers : {};
  // A hand-edited entry like "broken": null must not crash every command that iterates
  // providers; drop it the same way a bad providers object is dropped above.
  for (const [name, p] of Object.entries(c.providers)) {
    if (!p || typeof p !== "object" || Array.isArray(p)) delete c.providers[name];
  }
  c.routing = c.routing && typeof c.routing === "object" && !Array.isArray(c.routing) ? c.routing : {};
  if (typeof c.active !== "string") c.active = "";
  return c;
};
// Same idea for Claude's settings.json: a parsed JSON null/array is not an object.
const normalizeSettings = (s) => (s && typeof s === "object" && !Array.isArray(s) ? s : {});
const load = () => {
  try { return normalizeConfig(JSON.parse(fs.readFileSync(CFG, "utf8"))); }
  catch (e) { return normalizeConfig({ version: 1 }); }
};
const save = (c) => { atomicWrite(CFG, JSON.stringify(c, null, 2) + "\n", 0o600); };
const port = (c) => (c.listen && c.listen.port) || 8788;
const KEYS_PATH = path.join(path.dirname(CFG), 'keys.json');
const loadKeys = () => { try { return JSON.parse(fs.readFileSync(KEYS_PATH, 'utf8')); } catch { return {}; } };
const saveKeys = (k) => { atomicWrite(KEYS_PATH, JSON.stringify(k, null, 2) + '\n', 0o600); };
const mask = (k) => !k ? "(not set)" : k.startsWith("env:") ? k : "set (ends " + k.slice(-4) + ")";

const SETTINGS_PATH = path.join(claudeDir(), "settings.json");
const visibleProviders = (c) => Object.entries(c.providers || {}).filter(([, p]) => !p.hidden);
const composite = (p, id) => (id ? "prov/" + p + "/" + id : id);
const fmtCtx = (n) => (!n ? "?" : n >= 1e6 ? (n / 1e6).toFixed(n % 1e6 ? 1 : 0) + "M" : n >= 1e3 ? Math.round(n / 1e3) + "K" : String(n));
// Gemini's model list also contains image, audio, video, embedding and agent models that
// cannot answer a chat completion. Same predicate as bin/cc-setup.mjs uses on selection.
const isGeminiChatModel = (id) => !/(-tts|-image|image-preview|nano-banana|embedding|imagen|veo|lyria|live|transcribe|robotics|computer-use|deep-research|antigravity-|-aqa|native-audio|gemma-)/i.test(String(id));

function rebuild(c) {
  c.routing = {};
  for (const [name, p] of visibleProviders(c)) {
    for (const id of Object.keys(p.modelsById || {})) {
      const native = id.startsWith("claude-") || id.startsWith("anthropic/");
      c.routing[composite(name, id)] = ((native && c.providers[name + "~native"]) ? name + "~native" : name) + "::" + id;
    }
  }
}
function writePicker(c) {
  let settings = {};
  try { settings = JSON.parse(fs.readFileSync(SETTINGS_PATH, "utf8")); } catch (e) { settings = {}; }
  settings = normalizeSettings(settings);
  const switchRows = visibleProviders(c).map(([name, p]) => ({
    model: "provswitch/" + name,
    label: "\u21c4  Switch to " + name,
    description: "use " + (p.model || "default") + " \u00b7 " + p.type + (name === c.active ? " \u00b7 current" : ""),
  }));
  const options = [];
  for (const [name, p] of visibleProviders(c)) {
    for (const [id, info] of Object.entries(p.modelsById || {})) {
      const isActive = name === c.active && id === (p.model || p.defaultModel);
      options.push({
        model: composite(name, id),
        label: (info.name && info.name !== id ? info.name : id) + "  [" + name + "]",
        description: (info.tier === "free" ? "free tier" : info.tier === "paid" ? "paid only" : "") +
          (info.tier ? " - " : "") +
          (info.contextTokens ? fmtCtx(info.contextTokens) + " ctx" : "ctx unknown") +
          (info.inUsd == null ? "" : " - $" + info.inUsd + " in / $" + info.outUsd + " out per Mtok") +
          (isActive ? " - current" : ""),
      });
    }
  }
  settings.modelPicker = { replaceBuiltInOptions: true, options: [...switchRows, ...options] };
  fs.mkdirSync(path.dirname(SETTINGS_PATH), { recursive: true });
  fs.writeFileSync(SETTINGS_PATH, JSON.stringify(settings, null, 2) + "\n");
  return { switchRows, options };
}

function antigravityState() {
  try {
    const f = path.join(path.dirname(CFG), "antigravity.json");
    const c = JSON.parse(fs.readFileSync(f, "utf8"));
    if (c && c.access_token) return { ok: true, detail: "OAuth" + (c.email ? " " + c.email : "") + (c.project_id ? " · project " + c.project_id : "") };
    return { ok: false, detail: "not logged in (run: cc-termux antigravity login)" };
  } catch (e) { return { ok: false, detail: "not logged in (run: cc-termux antigravity login)" }; }
}

async function doctor(fix) {
  const c = load();
  const settingsPath = SETTINGS_PATH;
  const ks = loadKeys();
  const lines = [];
  let issues = 0, fixed = 0;
  const pass = (m) => lines.push("  \u2714 " + m);
  const warn = (m) => { issues++; lines.push("  \u26a0 " + m); };
  const fail = (m) => { issues++; lines.push("  \u2716 " + m); };

  lines.push("cc-termux doctor" + (fix ? "  (--fix)" : ""));
  const vis = visibleProviders(c);
  if (!vis.length) fail("no providers configured (run: cc-termux setup)"); else pass(vis.length + " provider(s): " + vis.map(([n]) => n).join(", "));

  for (const [name, p] of vis) {
    if (p.type === "antigravity") {
      const st = antigravityState();
      if (!st.ok) fail("provider " + name + ": " + st.detail); else pass("provider " + name + ": " + st.detail);
    } else if (!p.noKey && !ks[name] && !p.apiKeyEnv) {
      fail("provider " + name + " has no API key (cc-termux key " + name + " <key>)");
    }
    const mc = Object.keys(p.modelsById || {}).length;
    let shownModel = p.model;
    try {
      const sm = JSON.parse(fs.readFileSync(settingsPath, "utf8")).model || "";
      const mm = /^prov\/([^/]+)\/(.+)$/.exec(String(sm));
      if (mm && mm[1] === name) shownModel = mm[2];
    } catch (e) { }
    if (!mc) warn("provider " + name + " has no cached models (run: cc-termux setup)");
    else pass("provider " + name + ": " + shownModel + "  (" + mc + " models, retries " + (p.retries || 5) + ")");
  }

  try {
    const pids = await gatewayPids();
    if (pids.length > 1) warn(pids.length + " gateway processes running (run: cc-termux restart)");
  } catch (e) { }
  const portv = (c.listen && c.listen.port) || 8788;
  let health = null;
  try { health = await (await fetch("http://127.0.0.1:" + portv + "/health")).json(); } catch (e) {}
  if (health && health.ok) pass("gateway up on " + portv + " (active: " + health.active + ")");
  else lines.push("  - gateway not running (starts automatically on next claude run)");

  let settings = {};
  try { settings = JSON.parse(fs.readFileSync(settingsPath, "utf8")); } catch (e) {}
  settings = normalizeSettings(settings);
  const active = (c.providers || {})[c.active] || {};
  const wantModel = composite(c.active, active.model || active.defaultModel);
  const sm = settings.model || "";
  const smProv = (sm.match(/^prov\/([^/]+)\//) || [])[1];
  if (!sm) warn("settings.model is not set (default model falls back to aliases)");
  else if (sm.startsWith("provswitch/")) {
    if (fix && wantModel) { settings.model = wantModel; fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + "\n"); fixed++; pass("settings.model was a switch marker; set to " + wantModel); }
    else warn("settings.model is a provider-switch marker (" + sm + ")");
  } else if (smProv && !c.providers[smProv]) warn("settings.model points to removed provider " + smProv);
  else pass("settings.model: " + sm);

  const activeP = c.providers[c.active] || {};
  const expectedModel = c.active && activeP.model ? "prov/" + c.active + "/" + activeP.model : "";
  const sm2 = settings.model || "";
  const bare = /^claude-(opus|sonnet|haiku)-[0-9]/.test(sm2) && !sm2.startsWith("prov/");
  if (expectedModel && (!sm2 || bare)) {
    if (fix) { settings.model = expectedModel; fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + "\n"); fixed++; pass("settings.model set to " + expectedModel); }
    else warn("settings.model is " + (sm2 || "empty") + " - should be " + expectedModel + " (doctor --fix)");
  }
  {
    const rc = resolvedClaude();
    if (!rc) warn("no claude command on PATH (re-run the installer)");
    else if (!isOurShim(rc)) {
      const others = claudeCandidates().filter((p) => !isOurShim(p));
      if (fix) {
        for (const p of others) {
          try {
            if (process.platform === "win32") {
              // Never overwrite a .cmd with a POSIX script: write a cmd shim instead.
              fs.renameSync(p, p + ".official-backup");
              fs.writeFileSync(p, "@echo off\r\n\"" + process.execPath + "\" \"" + path.join(ROOT, "bin", "cc-launcher.mjs") + "\" %*\r\n");
            } else {
              fs.renameSync(p, p + ".official-backup");
              fs.writeFileSync(p, "#!/bin/sh\nexec \"" + process.execPath + "\" \"" + path.join(ROOT, "bin", "cc-launcher.mjs") + "\" \"$@\"\n");
              fs.chmodSync(p, 0o755);
            }
            fixed++;
          } catch (e) { }
        }
        pass("replaced foreign claude binary with the cc-termux shim (" + others.join(", ") + ")");
      } else warn("claude resolves to " + rc + " (official install, not the cc-termux shim) - doctor --fix replaces it");
    } else pass("claude resolves to the cc-termux shim");
  }
  const envKeys = Object.keys((settings.env) || {}).filter((k) => /^ANTHROPIC_/.test(k) || k === "CLAUDE_CODE_MAX_CONTEXT_TOKENS");
  if (envKeys.length) {
    if (fix) {
      for (const k of envKeys) delete settings.env[k];
      fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + "\n");
      fixed++; pass("removed conflicting settings.env keys: " + envKeys.join(", "));
    } else warn("settings.env overrides the launcher: " + envKeys.join(", ") + " (doctor --fix)");
  }
  const projCfgs = [path.join(process.cwd(), ".claude", "settings.json"), path.join(process.cwd(), ".claude", "settings.local.json")];
  for (const f of projCfgs) {
    if (path.resolve(f) === path.resolve(settingsPath)) continue;
    try {
      const ps = JSON.parse(fs.readFileSync(f, "utf8"));
      if (ps.model) warn("project settings set model: " + ps.model + "  (" + f + ")");
      const pe = Object.keys(ps.env || {}).filter((k) => /^ANTHROPIC_|^CLAUDE_CODE_MAX_CONTEXT/.test(k));
      if (pe.length) warn("project settings env overrides: " + pe.join(", ") + "  (" + f + ")");
    } catch (e) { }
  }
  const expected = vis.length + vis.reduce((n, [, p]) => n + Object.keys(p.modelsById || {}).length, 0);
  const have = ((settings.modelPicker || {}).options || []).length;
  if (have === expected) pass("model picker in sync (" + have + " rows)");
  else if (fix) { const r = writePicker(c); fixed++; pass("picker rebuilt: " + r.switchRows.length + " switch rows + " + r.options.length + " models"); }
  else fail("picker out of sync: has " + have + " rows, expected " + expected + " (cc-termux sync-picker)");

  const ov = c.override;
  if (ov) {
    const p = c.providers[ov.provider];
    const okModel = p && (!p.modelsById || !Object.keys(p.modelsById).length || p.modelsById[ov.model] || ov.model === p.model);
    if (!p) { if (fix) { delete c.override; save(c); fixed++; pass("removed invalid override"); } else warn("override points to missing provider " + ov.provider); }
    else if (!okModel) { if (fix) { c.override = { provider: ov.provider, model: p.model }; save(c); fixed++; pass("override model repaired to " + p.model); } else warn("override model " + ov.model + " is not in the catalog"); }
    else pass("override: " + ov.provider + " -> " + (ov.model || "default"));
  }

  const gem = vis.find(([n, p]) => n === "gemini" || /generativelanguage/.test(p.baseUrl || ""));
  if (gem) {
    const stale = Object.keys(gem[1].modelsById || {}).filter((id) => !isGeminiChatModel(id));
    if (!stale.length) pass("gemini catalog has only chat models (" + Object.keys(gem[1].modelsById || {}).length + ")");
    else if (fix) { for (const id of stale) delete gem[1].modelsById[id]; rebuild(c); save(c); writePicker(c); fixed++; pass("pruned " + stale.length + " non-chat gemini models"); }
    else warn(stale.length + " non-chat gemini models in picker (cc-termux doctor --fix)");
  }

  let patchOut = "";
  try {
    patchOut = execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-patch.mjs"), "--status"], { encoding: "utf8" });
    let applied = (patchOut.match(/applied/g) || []).length;
    let pending = (patchOut.match(/pending/g) || []).length;
    if (pending && fix) {
      // doctor --fix repairs this too, like the other fixable findings.
      try {
        execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-patch.mjs"), "--apply"], { encoding: "utf8" });
        patchOut = execFileSync(process.execPath, [path.join(ROOT, "bin", "cc-patch.mjs"), "--status"], { encoding: "utf8" });
        applied = (patchOut.match(/applied/g) || []).length;
        pending = (patchOut.match(/pending/g) || []).length;
        if (!pending) fixed++;
      } catch (e) { }
    }
    if (pending) warn(pending + " TUI patches pending (cc-termux patch)"); else pass("TUI patches applied (" + applied + ")");
  } catch (e) { warn("could not read patch status"); }

  // WebFetch's domain-safety check only works when both halves agree: the gateway's helper
  // must answer on 127.0.0.1:8799 (the patched URL) and the installed binary must carry the
  // byte patch that calls it. The port is fixed because patches.json bakes it into the URL.
  {
    const helperUrl = "http://127.0.0.1:8799/api/web/domain_infoxxxx?domain=example.com";
    let helperOk = false;
    try {
      const r = await fetch(helperUrl, { signal: AbortSignal.timeout(1500) });
      const j = await r.json();
      helperOk = !!(j && j.can_fetch === true);
    } catch (e) { helperOk = false; }
    let patchState = "unknown";
    if (/^\s*applied\s+web-fetch-domain-check/m.test(patchOut)) patchState = "applied";
    else if (/^\s*pending\s+web-fetch-domain-check/m.test(patchOut)) patchState = "pending";
    else if (/^\s*n\/a\s+web-fetch-domain-check/m.test(patchOut)) patchState = "missing";
    const helperNote = helperOk ? "helper answers on 8799" : "nothing answers on 8799";
    if (patchState === "applied" && helperOk) {
      pass("WebFetch domain check: " + helperNote + " and the binary is patched to use it");
    } else if (patchState === "applied") {
      warn("WebFetch domain check: binary is patched for 127.0.0.1:8799 but " + helperNote + " - WebFetch will fail (run: claude to start the gateway)");
    } else if (patchState === "pending") {
      warn("WebFetch domain check: " + helperNote + ", but the installed binary is not patched to use it - WebFetch will ask api.anthropic.com (run: cc-termux patch)");
    } else if (patchState === "missing") {
      warn("WebFetch domain check: this Claude Code build has no domain-check anchor, so the binary cannot be patched and " + helperNote + " (run: cc-termux update)");
    } else {
      warn("WebFetch domain check: cannot verify the binary patch (" + helperNote + ") - run: cc-termux update, then cc-termux patch");
    }
  }

  // The picker shim lives in different places per platform (and per install style).
  const ccpCandidates = [
    path.join(ROOT, "bin", process.platform === "win32" ? "ccp.cmd" : "ccp"),
    path.join(os.homedir(), ".local", "bin", process.platform === "win32" ? "ccp.cmd" : "ccp"),
    path.join(process.env.PREFIX || "", "bin", process.platform === "win32" ? "ccp.cmd" : "ccp"),
  ].filter((p) => p && !p.startsWith(path.sep + "bin"));
  const ccpPath = ccpCandidates.find((p) => { try { return fs.existsSync(p); } catch (e) { return false; } });
  if (ccpPath) pass("ccp picker installed"); else warn("ccp not installed (run install.sh)");
  try {
    const log = path.join(CACHE, "gateway.log");
    const tail = fs.readFileSync(log, "utf8").split("\n").slice(-300).join("\n");
    let qc = {}; try { qc = JSON.parse(fs.readFileSync(path.join(CACHE, "quota.json"), "utf8")); } catch (e) { }
    for (const [provider, q] of Object.entries(qc)) {
      if (!c.providers || !c.providers[provider]) continue;
      const age = Date.now() - new Date(q.at).getTime();
      // A burst limit clears in seconds; a daily limit only clears when the day rolls over.
      const window = q.kind === "burst" ? 10 * 60 * 1000 : 24 * 3600 * 1000;
      if (age > window) continue;
      const what = q.kind === "daily" ? "daily quota exhausted" : q.kind === "burst" ? "rate limited (per-minute)" : q.status;
      warn("provider " + provider + ": " + what + (q.model ? " on " + q.model : "") + (q.limit != null ? " (limit " + q.limit + ")" : "") + " at " + q.at);
    }
  } catch (e) { }
  const deny = (settings.permissions && settings.permissions.deny) || [];
  if (deny.length >= 4) pass("secret deny rules: " + deny.length); else warn("secret deny rules missing (re-run install.sh)");

  try {
    const log = path.join(CACHE, "gateway.log");
    const sz = fs.statSync(log).size;
    if (sz > 5 * 1024 * 1024) { if (fix) { fs.writeFileSync(log, ""); fixed++; pass("gateway.log truncated (" + (sz / 1e6).toFixed(1) + " MB)"); } else warn("gateway.log is " + (sz / 1e6).toFixed(1) + " MB (--fix truncates)"); }
    else pass("gateway.log " + (sz / 1024).toFixed(0) + " KB");
  } catch (e) {}

  console.log(lines.join("\n"));
  console.log("");
  console.log(issues === 0 ? "all checks passed" : issues + " issue(s)" + (fix ? ", " + fixed + " fixed" : " (run: cc-termux doctor --fix)"));
}
function claudeCandidates() {
  const dirs = String(process.env.PATH || '').split(path.delimiter).filter(Boolean);
  const out = [];
  for (const d of dirs) {
    const p = path.join(d, process.platform === 'win32' ? 'claude.cmd' : 'claude');
    try { if (fs.existsSync(p)) out.push(p); } catch (e) { }
  }
  return [...new Set(out)];
}
function isOurShim(p) {
  try { return /cc-launcher\.mjs/.test(fs.readFileSync(p, 'utf8')); } catch (e) { return false; }
}
function resolvedClaude() {
  const c = claudeCandidates();
  return c.length ? c[0] : null;
}
async function checkProviderKey(name, p) {
  if (p.type === "antigravity") return antigravityState();
  if (p.noKey) return { ok: true, detail: 'no key required' };
  const key = loadKeys()[name];
  if (!key) return { ok: false, detail: 'no key stored' };
  const timeout = (ms) => AbortSignal.timeout(ms);
  try {
    if (/generativelanguage/.test(p.baseUrl || '')) {
      const r = await fetch('https://generativelanguage.googleapis.com/v1beta/models?key=' + encodeURIComponent(key), { signal: timeout(8000) });
      return r.ok ? { ok: true, detail: 'models endpoint 200' } : { ok: false, detail: 'models endpoint HTTP ' + r.status };
    }
    const base = String(p.baseUrl).replace(/\/$/, '');
    const urls = [...new Set([base + '/models', base.replace(/\/v1.*$/, '') + '/v1/models', base + '/v1/models'])];
    let last = '';
    for (const u of urls) {
      try {
        const r = await fetch(u, { headers: { authorization: 'Bearer ' + key }, signal: timeout(8000) });
        if (r.ok) return { ok: true, detail: u.replace(/^https?:\/\//, '').slice(0, 60) + ' 200' };
        last = 'HTTP ' + r.status + ' @ ' + u.replace(/^https?:\/\//, '').slice(0, 50);
      } catch (e) { last = e.name || e.code; }
    }
    return { ok: false, detail: last || 'unreachable' };
  } catch (e) { return { ok: false, detail: e.name || e.code }; }
}
async function diagnose() {
  const c = (() => { try { return load(); } catch (e) { return null; } })();
  const hdr = (s) => console.log("\n" + s);
  hdr("cc-termux diagnose");
  console.log("  node      " + process.version + "  " + process.platform + "/" + process.arch);
  console.log("  root      " + ROOT + "  exists=" + fs.existsSync(ROOT));
  console.log("  config    " + CFG + "  exists=" + fs.existsSync(CFG));
  if (!c) console.log("  config    INVALID JSON");
  else {
    const vis = Object.entries(c.providers || {}).filter(([, p]) => !p.hidden);
    const ks = loadKeys();
    console.log("  providers " + (vis.length ? vis.map(([n, p]) => n + "(" + (p.type === "antigravity" ? "OAuth" : p.noKey ? "no key" : (ks[n] ? "key" : "no key")) + ")").join(", ") : "none"));
    console.log("  active    " + (c.active || "(none)") + "  override=" + JSON.stringify(c.override || null));
  {
    const rc = resolvedClaude();
    console.log("  claude    " + (rc || "(not found on PATH)") + (rc ? (isOurShim(rc) ? "  [our shim]" : "  [NOT ours - official install?]") : ""));
    for (const p of claudeCandidates().slice(1)) console.log("            also: " + p + (isOurShim(p) ? " [ours]" : " [not ours]"));
  }
  try {
    const st = JSON.parse(fs.readFileSync(path.join(claudeDir(), "settings.json"), "utf8"));
    console.log("  settings  model=" + (st.model || "(none)"));
    const ek = Object.keys(st.env || {}).filter((k) => /^ANTHROPIC_|^CLAUDE_CODE_MAX_CONTEXT/.test(k));
    if (ek.length) console.log("  settings  env overrides=" + ek.join(", "));
  } catch (e) { console.log("  settings  (unreadable)"); }
    console.log("  port      " + ((c.listen && c.listen.port) || 8788));
  }
  if (c) {
    for (const [name, p] of Object.entries(c.providers || {}).filter(([, q]) => !q.hidden)) {
      const res = await checkProviderKey(name, p);
      console.log("  key " + name.padEnd(12) + (res.ok ? "OK   " : "FAIL ") + res.detail);
    }
  }
  const bin = path.join(ROOT, "bin", process.platform === "win32" ? "claude.exe" : "claude.bin");
  let bstat = null; try { bstat = fs.statSync(bin); } catch (e) {}
  console.log("  binary    " + bin + (bstat ? "  " + (bstat.size / 1e6).toFixed(1) + " MB" : "  MISSING"));
  if (!bstat) {
    console.log("  next      install Claude Code: cc-termux update");
    return;
  }
  console.log("  direct    " + fs.existsSync(path.join(ROOT, ".direct-exec")));
  try { console.log("  loader    " + fs.readdirSync(path.join(ROOT, "lib")).join(", ")); } catch (e) { console.log("  loader    none"); }
  console.log("  LD_PRELOAD " + (process.env.LD_PRELOAD || "(none)"));
  for (const k of ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"]) if (process.env[k]) console.log("  " + k + " " + process.env[k]);
  const port = (c && c.listen && c.listen.port) || 8788;
  let health = null;
  try { health = await (await fetch("http://127.0.0.1:" + port + "/health", { signal: AbortSignal.timeout(1500) })).json(); } catch (e) {}
  const pids = await gatewayPids();
  console.log("  gateway   " + (health ? "UP active=" + health.active : "DOWN") + "  pids=" + JSON.stringify(pids));
  if (!c || !c.active || !(c.providers && c.providers[c.active])) {
    console.log("  next      run: cc-termux setup");
    return;
  }
  if (!health) {
    hdr("gateway start attempt");
    const { spawn } = await import("node:child_process");
    const child = spawn(process.execPath, [path.join(ROOT, "proxy", "server.mjs")], { env: { ...process.env, CC_TERMUX_CONFIG: CFG }, stdio: ["ignore", "pipe", "pipe"] });
    let buf = ""; child.stdout.on("data", (d) => buf += d); child.stderr.on("data", (d) => buf += d);
    let started = false;
    for (let i = 0; i < 30; i++) {
      try { health = await (await fetch("http://127.0.0.1:" + port + "/health", { signal: AbortSignal.timeout(500) })).json(); started = true; break; } catch (e) {}
      await new Promise((r) => setTimeout(r, 100));
    }
    console.log("  started: " + (started ? "yes" : "no"));
    if (buf.trim()) console.log((buf.trim()).split("\n").slice(-8).join("\n"));
    try { child.kill(); } catch (e) {}
  }
  hdr("hints");
  if (!c || !Object.keys(c.providers || {}).length) console.log("  - no provider configured: run: cc-termux setup");
  if (process.env.HTTP_PROXY || process.env.HTTPS_PROXY) console.log("  - proxy env is set; add 127.0.0.1 to NO_PROXY");
  if (!bstat) console.log("  - binary missing: re-run the installer");
  if (pids.length > 1) console.log("  - duplicate gateways: cc-termux restart");
}

