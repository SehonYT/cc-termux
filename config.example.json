{
  "listen": {
    "host": "127.0.0.1",
    "port": 8788
  },
  "active": "tokens",
  "routing": {
    "claude-haiku-5-5": "haiku:claude-haiku-5-5"
  },
  "providers": {
    "tokens": {
      "type": "openai",
      "baseUrl": "https://tokens.bd",
      "path": "/v1/chat/completions",
      "apiKeyEnv": "TOKENS_BD_KEY",
      "model": "deepseek/deepseek-v4.1-flash",
      "defaultModel": "deepseek/deepseek-v4.1-flash",
      "contextWindow": 1000000,
      "aliases": {
        "opus": "deepseek/deepseek-v4.1-flash",
        "sonnet": "deepseek/deepseek-v4.1-flash",
        "haiku": "claude-haiku-5-5",
        "subagent": "claude-haiku-5-5"
      },
      "models": {},
      "apiMode": "auto",
      "name": "tokens",
      "retries": 5,
      "retryBaseMs": 800,
      "retryMaxMs": 20000
    },
    "haiku": {
      "type": "anthropic",
      "baseUrl": "https://tokens.bd",
      "path": "/v1/messages",
      "apiKeyEnv": "TOKENS_BD_KEY",
      "model": "claude-haiku-5-5",
      "defaultModel": "claude-haiku-5-5",
      "contextWindow": 1000000,
      "models": {},
      "name": "haiku",
      "retries": 5,
      "retryBaseMs": 800,
      "retryMaxMs": 20000
    },
    "openrouter": {
      "type": "anthropic",
      "baseUrl": "https://openrouter.ai/api",
      "path": "/v1/messages",
      "apiKeyEnv": "OPENROUTER_KEY",
      "model": "anthropic/claude-sonnet-4.6",
      "defaultModel": "anthropic/claude-sonnet-4.6",
      "contextWindow": 200000,
      "aliases": {
        "opus": "anthropic/claude-opus-4.5",
        "sonnet": "anthropic/claude-sonnet-4.6",
        "haiku": "anthropic/claude-haiku-4.5",
        "subagent": "anthropic/claude-sonnet-4.6"
      },
      "models": {},
      "name": "openrouter",
      "retries": 5,
      "retryBaseMs": 800,
      "retryMaxMs": 20000
    },
    "gemini": {
      "type": "openai",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "path": "/chat/completions",
      "apiKeyEnv": "GEMINI_API_KEY",
      "model": "gemini-2.5-pro",
      "defaultModel": "gemini-2.5-pro",
      "contextWindow": 1048576,
      "aliases": {
        "opus": "gemini-2.5-pro",
        "sonnet": "gemini-2.5-pro",
        "haiku": "gemini-2.5-flash",
        "subagent": "gemini-2.5-flash"
      },
      "models": {},
      "apiMode": "auto",
      "name": "gemini",
      "retries": 5,
      "retryBaseMs": 800,
      "retryMaxMs": 20000
    }
  }
}
