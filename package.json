{
  "name": "modelmesh",
  "version": "0.2.0",
  "description": "Run Claude Code on any platform (Termux, Linux, macOS, Windows) with third-party model providers and a local gateway.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "modelmesh": "bin/modelmesh",
    "mm": "bin/mm.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "install:check": "node install.mjs --check",
    "test": "node tests/run-tests.mjs"
  },
  "keywords": [
    "claude-code",
    "termux",
    "android",
    "openai-compatible",
    "gateway",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SehonYT/modelmesh.git"
  },
  "homepage": "https://github.com/SehonYT/modelmesh#readme",
  "bugs": {
    "url": "https://github.com/SehonYT/modelmesh/issues"
  }
}
